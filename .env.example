# Any OpenAI-compatible chat completions endpoint works. Copy this file to .env and fill in the key.
# Gemini: LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# Claude: set LLM_PROVIDER=anthropic, LLM_API_KEY=<your Anthropic key>, LLM_MODEL=claude-opus-5 (LLM_BASE_URL is ignored)
LLM_PROVIDER=
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_API_KEY=
LLM_MODEL=google/gemma-4-31b-it:free
